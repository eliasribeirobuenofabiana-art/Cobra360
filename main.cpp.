// COBRA 360 - jogo da cobrinha estilo Nokia para Xbox 360 (libxenon)
// Controles: D-Pad ou analogico esquerdo, A confirma, B volta, START pausa

#include <stdio.h>
#include <stdlib.h>
#include <string.h>

extern "C" {
#include <xenos/xenos.h>
#include <console/console.h>
#include <input/input.h>
#include <usb/usbmain.h>
#include <time/time.h>
#include <xenon_smc/xenon_smc.h>
}

#define W 24
#define H 14
#define DEAD 16000

struct Pt { int x, y; };

static Pt snake[W * H];
static int len, dir, ndir, gx, gy, score, best = 0;
static int optSpeed = 1;   // 0 lenta, 1 normal, 2 rapida
static int optWall = 1;    // 1 parede mata, 0 atravessa
static const int tickMs[3] = {200, 120, 70};
static const char *speedName[3] = {"LENTA ", "NORMAL", "RAPIDA"};

// ---------- entrada ----------
struct Input { int up, down, left, right, a, b, start; };
static struct controller_data_s prev, cur;
static unsigned int seed = 12345;

static Input readInput() {
    usb_do_poll();
    prev = cur;
    get_controller_data(&cur, 0);
    seed++;
    Input in;
    int u = cur.up || cur.s1_y > DEAD;
    int d = cur.down || cur.s1_y < -DEAD;
    int l = cur.left || cur.s1_x < -DEAD;
    int r = cur.right || cur.s1_x > DEAD;
    in.up = u; in.down = d; in.left = l; in.right = r;
    in.a = cur.a && !prev.a;
    in.b = cur.b && !prev.b;
    in.start = cur.start && !prev.start;
    return in;
}

// ---------- jogo ----------
static void placeGrape() {
    for (;;) {
        gx = rand() % W;
        gy = rand() % H;
        int ok = 1;
        for (int i = 0; i < len; i++)
            if (snake[i].x == gx && snake[i].y == gy) { ok = 0; break; }
        if (ok) return;
    }
}

static void resetGame() {
    len = 3;
    dir = ndir = 1; // 0 cima, 1 direita, 2 baixo, 3 esquerda
    for (int i = 0; i < len; i++) { snake[i].x = 6 - i; snake[i].y = H / 2; }
    score = 0;
    srand(seed);
    placeGrape();
}

static void draw(bool paused) {
    static char buf[4096];
    char *p = buf;
    p += sprintf(p, "\n   COBRA 360     UVAS: %d     RECORDE: %d\n\n   ", score, best);
    for (int x = 0; x < W + 2; x++) p += sprintf(p, "##");
    p += sprintf(p, "\n");
    for (int y = 0; y < H; y++) {
        p += sprintf(p, "   ##");
        for (int x = 0; x < W; x++) {
            const char *c = "  ";
            if (x == gx && y == gy) c = "()";
            for (int i = len - 1; i >= 0; i--)
                if (snake[i].x == x && snake[i].y == y) { c = (i == 0) ? "@@" : "[]"; break; }
            p += sprintf(p, "%s", c);
        }
        p += sprintf(p, "##\n");
    }
    p += sprintf(p, "   ");
    for (int x = 0; x < W + 2; x++) p += sprintf(p, "##");
    p += sprintf(p, "\n\n   %s\n", paused ? "PAUSADO - START continua, B menu" : "START pausa");
    console_clrscr();
    printf("%s", buf);
}

// retorna 1 = jogar de novo, 0 = menu
static int gameOver() {
    int sel = 0;
    for (;;) {
        console_clrscr();
        printf("\n\n\n      GAME OVER\n\n      UVAS: %d   RECORDE: %d\n\n", score, best);
        printf("      %s JOGAR DE NOVO\n      %s MENU\n", sel == 0 ? ">" : " ", sel == 1 ? ">" : " ");
        Input in = readInput();
        if (in.up || in.down) { sel = !sel; mdelay(180); }
        if (in.a) return sel == 0;
        mdelay(30);
    }
}

static void play() {
    for (;;) {
        resetGame();
        bool paused = false, dead = false;
        int acc = 0;
        draw(false);
        while (!dead) {
            Input in = readInput();
            if (in.start) { paused = !paused; draw(paused); }
            if (paused) { if (in.b) return; mdelay(30); continue; }

            if (in.up && dir != 2) ndir = 0;
            else if (in.right && dir != 3) ndir = 1;
            else if (in.down && dir != 0) ndir = 2;
            else if (in.left && dir != 1) ndir = 3;

            mdelay(10);
            acc += 10;
            if (acc < tickMs[optSpeed]) continue;
            acc = 0;

            dir = ndir;
            Pt h = snake[0];
            if (dir == 0) h.y--; else if (dir == 1) h.x++;
            else if (dir == 2) h.y++; else h.x--;

            if (h.x < 0 || h.x >= W || h.y < 0 || h.y >= H) {
                if (optWall) { dead = true; break; }
                h.x = (h.x + W) % W;
                h.y = (h.y + H) % H;
            }
            for (int i = 0; i < len; i++)
                if (snake[i].x == h.x && snake[i].y == h.y) dead = true;
            if (dead) break;

            bool ate = (h.x == gx && h.y == gy);
            if (ate && len < W * H) len++;
            for (int i = len - 1; i > 0; i--) snake[i] = snake[i - 1];
            snake[0] = h;
            if (ate) { score++; if (score > best) best = score; placeGrape(); }
            draw(false);
        }
        if (!dead) return;
        if (!gameOver()) return;
    }
}

// ---------- menus ----------
static void options() {
    int sel = 0;
    for (;;) {
        console_clrscr();
        printf("\n\n\n      OPCOES\n\n");
        printf("      %s VELOCIDADE: %s\n", sel == 0 ? ">" : " ", speedName[optSpeed]);
        printf("      %s PAREDE: %s\n", sel == 1 ? ">" : " ", optWall ? "MATA     " : "ATRAVESSA");
        printf("\n      D-Pad: escolher/mudar   B: voltar\n");
        Input in = readInput();
        if (in.b) return;
        if (in.up || in.down) { sel = !sel; mdelay(180); }
        if (in.left || in.right || in.a) {
            if (sel == 0) optSpeed = (optSpeed + (in.left ? 2 : 1)) % 3;
            else optWall = !optWall;
            mdelay(200);
        }
        mdelay(30);
    }
}

int main() {
    xenos_init(VIDEO_MODE_AUTO);
    console_init();
    usb_init();
    usb_do_poll();
    memset(&cur, 0, sizeof(cur));
    memset(&prev, 0, sizeof(prev));

    int sel = 0;
    const char *items[3] = {"JOGAR", "OPCOES", "SAIR"};
    for (;;) {
        console_clrscr();
        printf("\n\n\n      ==== COBRA 360 ====\n\n");
        for (int i = 0; i < 3; i++) printf("      %s %s\n", sel == i ? ">" : " ", items[i]);
        printf("\n      D-Pad: escolher   A: confirmar\n");
        Input in = readInput();
        if (in.up) { sel = (sel + 2) % 3; mdelay(180); }
        if (in.down) { sel = (sel + 1) % 3; mdelay(180); }
        if (in.a) {
            if (sel == 0) play();
            else if (sel == 1) options();
            else { xenon_smc_power_shutdown(); }
        }
        mdelay(30);
    }
    return 0;
}
